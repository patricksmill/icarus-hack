# the game and anything made from it stays out: dumps, decompiles, mod binaries, states
dumps/
patch/
analysis/*.c
analysis/mod/*.bin
analysis/strings.txt
analysis/*.log
trace/
build/
dist/
ghidra/project/
ghidra/modproject/
ghidra/reports/
# other people's repos and big downloads; ours are listed below
tools/*
!tools/kiutrace/
!tools/funclist/
tools/kiutrace/target/
tools/funclist/target/
*:Zone.Identifier
# disassembly of game or mod code, regenerated by the ghidra scripts
analysis/*_disasm.txt
analysis/mod/
